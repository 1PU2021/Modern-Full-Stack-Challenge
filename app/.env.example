# For local (non-Docker) runs, either export these into your shell or run with: node --env-file=.env src/<service>/index.js
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Migration/admin connection -- used by `npm run migrate`, seed scripts, and
# the integration test suite's fixture setup. Needs full DDL privileges to
# create tables, roles, and RLS policies, and bypasses RLS (a superuser or
# equivalent owner role) so fixture seeding across tenants works. Never
# used by the running services themselves.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notifications

# App connection -- what the running services (intake/fanout/dispatch)
# actually use. Connects as the least-privilege app_user role the
# migrations create; RLS genuinely restricts this role, unlike the
# superuser DATABASE_URL above.
APP_DATABASE_URL=postgres://app_user:app_user@localhost:5432/notifications

AWS_REGION=us-east-2
SQS_ENDPOINT=http://localhost:9324
ALERT_FANOUT_QUEUE_URL=http://localhost:9324/queue/alert-fanout
RECIPIENT_DISPATCH_QUEUE_URL=http://localhost:9324/queue/recipient-dispatch

# Dummy credentials ElasticMQ accepts (it ignores signature validation) --
# the AWS SDK's default credential provider chain reads these directly from
# process.env itself, so this is the one documented exception to "only
# config.js reads process.env" in this codebase: modeling AWS's own
# credential-provider-chain vars in a custom Zod schema would just
# reimplement what the SDK already does correctly.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

JWT_SECRET=dev-secret-change-me

# Signs/verifies platform-admin tokens only (see src/intake/platform-auth.js).
# Deliberately a DIFFERENT secret from JWT_SECRET above: platform and tenant
# tokens are isolated by both claim shape and signing secret, so a leaked
# JWT_SECRET alone can never be used to forge a platform-admin token.
PLATFORM_JWT_SECRET=dev-platform-secret-change-me

# Demo-only seeded login password. Do not reuse this authentication model or
# credential in a production environment.
DEMO_USER_PASSWORD=demo-only-change-me

SMS_PROVIDER_URL=http://localhost:4000
EMAIL_PROVIDER_URL=http://localhost:4001

MAX_DELIVERY_ATTEMPTS=5

# Recipient address -> coordinates geocoding (see src/intake/geocoder.js).
# 'none' (default): no outbound geocoding calls; tenant admins fall back to
# entering coordinates manually under "Advanced location" in the UI.
# 'nominatim': calls OpenStreetMap's free public Nominatim API. Its usage
# policy (https://operations.osmfoundation.org/policies/nominatim/) requires
# a valid custom User-Agent identifying the application and caps requests at
# 1/second for the whole process -- both are enforced in code, not just here.
GEOCODER_PROVIDER=none
# Required only when GEOCODER_PROVIDER=nominatim. Identify your app and a
# contact per Nominatim's usage policy -- do not ship this demo default as-is
# in anything other people rely on.
GEOCODER_USER_AGENT=critical-notifications-demo (set-a-real-contact@example.test)
